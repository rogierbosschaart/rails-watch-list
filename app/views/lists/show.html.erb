<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fbatterseapowerstation.co.uk%2Fcontent%2Fuploads%2F2022%2F08%2FCinema-in-the-Power-Station-image001hero-1600x869.jpg&f=1&nofb=1&ipt=314486976e606edb0229c8f33011a9186e16e33775be0637ee3714dc07d3b039);">
  <div class="container">
    <h1> <%= @list.name %> </h1>
  </div>
</div>



<div class="container my-3">

  <div class="d-flex justify-content-end px-4 py-2">
    <%# <%= link_to "Add movies",  new_list_bookmark_path(@list), class:"btn btn-outline-success" %> %>
  </div>

  <div class="row">
    <div class="col-12">

      <div class="bookmark-container">
      <%# BOOKMARKS SECTION%>
        <% @list.bookmarks.each do |bookmark| %>
          <div class="bookmark-card m-3">
            <div class="card-image">
              <%= image_tag "#{bookmark.movie.poster_url}", alt: "#{bookmark.movie.title}", class:"img-fluid. max-width: 100%; and height: auto;", crop: :fill %>
            </div>

            <div class="card-text">
              <div class="card-header d-flex justify-content-between">
                <h2> <%= bookmark.movie.title %> </h2>
                <h2> <%= bookmark.movie.rating %> </h2>
              </div>

              <div class="card-body">
                <p><%= bookmark.movie.overview %></p>
              </div>
              <div>
                <%= link_to "delete", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Are you sure" }, class:"delete-link" %>
              </div>
            </div>


          </div>
        <% end %>
      </div>

      <hr>

      <h1>Add movies</h1>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie %>
        <%= f.input :comment %>
        <%= f.submit "Add bookmark", class:"btn btn-outline-success" %>
      <% end %>

      <hr>

      <%# REVIEWS SECTION %>
      <div class="reviews-container">
        <div class="reviews-list">
          <h2>Reviews</h2>
          <div class="review">
            <% @list.reviews.each do |review| %>
              <div class="review-comment">
                <p> <%= review.comment %> </p>
              </div>
              <div class="review-rating">
                <%= review.rating %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="reviews-form">
          <%= simple_form_for [@list, @review] do |f| %>
            <%= f.input :comment %>
            <%= f.input :rating %>
            <%= f.submit "Add review", class:"btn btn-outline-success" %>
          <% end %>
        </div>

      </div>

      <hr>

    </div>
  </div>
  <%= link_to "Back to lists",  root_path, class:"btn btn-outline-primary" %>
</div>
