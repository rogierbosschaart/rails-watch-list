<div class="container my-3">

  <%= link_to "< Back to lists",  root_path, class:"btn btn-outline-primary" %>
  <div class="row">
    <div class="col-4 my-4 mx-auto">
      <h1>Add a list</h1>

      <div class="form">
        <%= simple_form_for(@list) do |f| %>
          <%= f.input :name %>
          <%= f.submit "Add list", class:"btn btn-outline-success" %>
        <% end %>
      </div>


    </div>
  </div>
</div>
