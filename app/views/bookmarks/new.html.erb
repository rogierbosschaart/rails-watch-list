<div class="container my-3">
  <div class="row">
    <div class="col-8 mx-auto">

      <h1>Add movies</h1>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie %>
        <%= f.input :comment %>
        <%= f.submit "Add bookmark", class:"btn btn-outline-success" %>
      <% end %>

    </div>
  </div>
  <%= link_to "Back to #{@list.name} list",  list_path(@list), class:"btn btn-outline-primary" %>
</div>
